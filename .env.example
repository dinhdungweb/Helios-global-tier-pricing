# Shopify Global store configuration
SHOPIFY_SHOP=your-global-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CURRENCY=USD
SHOPIFY_COUNTRY=US
REQUIRE_APP_PROXY=true
DISABLE_LEGACY_ENDPOINT=true
ALLOWED_ORIGINS=https://your-global-domain.com,https://your-global-store.myshopify.com

# Legacy endpoint/fallback only. Secure checkout reads the published theme.
TIER_CONFIG_JSON=[{"name":"BLACK DIAMOND","tag":"BLACK DIAMOND","discount":15,"threshold":20000},{"name":"DIAMOND","tag":"DIAMOND","discount":12,"threshold":3500},{"name":"PLATINUM","tag":"PLATINUM","discount":10,"threshold":1500},{"name":"GOLD","tag":"GOLD","discount":8,"threshold":500},{"name":"SILVER","tag":"SILVER","discount":5,"threshold":250},{"name":"MEMBER","tag":"","discount":0,"threshold":0}]
# SHOPIFY_ACCESS_TOKEN must include the read_themes scope.
# Secure checkout reads settings_data.json + settings_schema.json from MAIN.
# This is only the in-memory cache lifetime; a changed theme updatedAt always
# invalidates the cache on the next checkout request.
THEME_POLICY_CACHE_TTL_MS=60000
TIER_PRIORITIZE_TAGS=true
TIER_PRICING_SCOPE=all
TIER_PRICING_PRODUCT_TAGS=
TIER_PRICING_COLLECTION_HANDLES=

# Free gifts are disabled unless explicitly configured server-side.
FREE_GIFT_ENABLED=false
FREE_GIFT_VARIANT_IDS=
FREE_GIFT_TRIGGER_COLLECTION=
FREE_GIFT_MINIMUMS_JSON={}

# Required Admin API scopes: write_draft_orders, read_products, read_customers
# Keep REQUIRE_APP_PROXY=true in Production.
